        "promptType": "define",
        "text": "=You are a professional assistant.\n\nUser asked:\n{{$node[\"Normalize Input\"].json[\"userMessage\"]}}\n\nDatabase Results:\n{{$json}}\n\nRespond naturally and clearly using only the provided data.\nIf multiple results exist, summarize them professionally.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
