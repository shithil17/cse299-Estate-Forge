      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const chatInput = String($json.chatInput ?? '');\nconst idMatch   = chatInput.match(/\\bbproperty-\\d+\\b/i);\nconst propertyId = idMatch ? idMatch[0].toLowerCase() : '';\n\nreturn {\n  ...$json,\n  userQuestion: chatInput,\n  propertyId,\n};"
      },
      "id": "9f1cfb79-e4c6-42b6-a500-f4f39179b4f8",
      "name": "Extract Property ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "33333333-3333-3333-3333-333333333333",
              "leftValue": "={{ $json.propertyId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a9b0c123-d456-789a-e1f2-a3b4c5d6e7f8",
      "name": "If Property ID Exists",
      "type": "n8n-nodes-base.if",
