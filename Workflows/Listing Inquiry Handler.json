    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "44444444-4444-4444-4444-444444444444",
              "name": "output",
              "value": "Please provide a property ID in the format bproperty-<number> (e.g. bproperty-0) so I can look up the listing.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b0c1d234-e567-89ab-f1a2-b3c4d5e6f7a8",
      "name": "No ID Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        640,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userQuestion }}",
        "options": {
          "systemMessage": "You are a Listing Inquiry Handler assistant for a Bangladeshi real-estate platform.\n\nThe property ID has already been extracted and validated upstream. Your only jobs are:\n1) Use the MySQL tool once to fetch listing data for the property.\n2) Answer only from the returned listing fields. Focus on property_overview and property_description.\n3) For balcony questions, only confirm a balcony if it is explicitly mentioned in the overview or description text. Do not infer.\n\nDatabase table: properties\nColumns available: id, city, locality, property_overview, property_description,\n  relaxation_amenity_count, security_amenity_count, social_amenity_count,\n  service_staff_amenity_count, property_url\n\nResponse rules:\n- If the DB returns no row, say the listing was not found.\n- If found, answer clearly and cite the specific listing text as evidence.\n- Keep tone concise and helpful."
        }
      },
      "id": "dc522651-5e0b-4b4d-b36e-0f0e5e724209",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        640,
        192
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite-preview",
        "options": {}
      },
      "id": "6f6b64f6-9c93-44ac-a832-a69e339fe500",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        480,
        432
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "A0yo4kyslyDfzJcz",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, city, locality, property_overview, property_description, relaxation_amenity_count, security_amenity_count, social_amenity_count, service_staff_amenity_count, property_url FROM properties WHERE id = '{{ $json.propertyId }}' LIMIT 1;",
        "options": {}
      },
